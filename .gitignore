# Never commit real credentials, keys, or secrets
*.pem
*.key
id_rsa*
id_ed25519*
*_rsa
*_ed25519
known_hosts
*.pfx
*.p12
.env
secrets.yml
secrets.yaml

# Never commit real config backups (may contain hashed passwords, real IPs, tokens)
config-backups/
*.bak

# Real backup snapshots pulled by the scripts in /scripts -- these are
# meant to run against YOUR devices with YOUR IPs, not be committed here
backup-*.log
isolation-check.log

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*~

# Local scratch
/tmp/
*.tmp
